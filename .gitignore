# Scratch probe/repro scripts — underscore-prefixed; self-declared "untracked, not committed".
scripts/_*.mjs

# Human Playtest Harness — raw per-run artifacts. The curated *FINDINGS*/*PACKETS* docs and the
# specific run reports / replay logs they cite as evidence are committed explicitly (git add -f).
docs/playtests/harness/actions-*.json
docs/playtests/harness/harness-*.md
docs/playtests/harness/saturation-*.md
docs/playtests/harness/transcript-sample.txt

# Visual Map Gate — raw per-run map screenshots. The curated run report under
# docs/playtests/visual-map-gate-*.md is committed explicitly as the evidence record.
output/

# Cockpit — local-only state (budget ledger, window handoff)
.budget.json
.claude/handoff-latest.md
.claude/engine-edit-ok
