# Server-only. Never expose this key to the browser.
OPENAI_API_KEY=

# Server-only. Never expose this key to the browser. Anthropic takes priority
# over OPENAI_API_KEY when both are set (server/llmProvider.js detectProvider).
# Powers narration polish, NPC voice, and the INT-2 server-side intent
# proposal (engine/intent/llmIntent.js) — absent key = silent fallback to the
# deterministic path everywhere.
ANTHROPIC_API_KEY=

# Optional: override the Anthropic/OpenAI model id server/llmProvider.js uses.
# NOTE: the hardcoded ANTHROPIC_DEFAULT_MODEL in server/llmProvider.js may lag
# the live API (verified 2026-07-03 — see docs/playtests/intent-eval-*.md); set
# this if the default 404s.
LLM_MODEL=

# Optional: local Ollama endpoint/model for the offline NPC-brain / rumor /
# physics-detect lanes and the INT-2 LLM-intent fallback (docs/LOCAL_LLM.md).
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# Set to 'off' to disable the INT-2 server-side LLM-intent proposal outright
# (PACKETS.md INT-2 rollback). With a key present this path fires automatically
# on any low-confidence turn — a small, real spend against the $20 dev budget —
# so flip this off if you want ANTHROPIC_API_KEY active for narration/NPC voice
# without the per-turn intent-proposal calls.
INTENT_LLM=

# Optional: default UI selection (client still allows OFF/POLISH/CONDUCT)
AI_MODE=OFF

# Optional: override server-side model (default is a lightweight model)
OPENAI_MODEL=gpt-4.1-mini
