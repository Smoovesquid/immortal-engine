# Server-only. Never expose this key to the browser.
OPENAI_API_KEY=

# Server-only. Never expose this key to the browser. Anthropic takes priority
# over OPENAI_API_KEY when both are set (server/llmProvider.js detectProvider).
# Powers narration polish, NPC voice, and the INT-2 server-side intent
# proposal (engine/intent/llmIntent.js) as the FALLBACK ear behind Ollama —
# absent key = silent fallback to the deterministic path everywhere.
ANTHROPIC_API_KEY=

# Optional: override the Anthropic/OpenAI model id server/llmProvider.js uses.
# server/llmProvider.js's ANTHROPIC_DEFAULT_MODEL was fixed 2026-07-03 (was
# 404ing against the live API) to match engine/llmAdapter.js's working
# default — only set this if you want a DIFFERENT model than that default.
LLM_MODEL=

# Optional: local Ollama endpoint/model for the offline NPC-brain / rumor /
# physics-detect lanes and — as of INT-2R (2026-07-03) — the PRIMARY seat for
# the live-turn intent translator (docs/LOCAL_LLM.md). Every typed turn asks
# this model first; Anthropic only fires on an Ollama miss (see INTENT_LLM).
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# Selects which provider(s) the live-turn intent translator (server-side,
# engine/intent/llmIntent.js) consults, on EVERY typed free-text turn (no
# confidence gate — INT-2R):
#   off        — no provider is ever consulted (PACKETS.md INT-2 rollback;
#                zero outbound calls, the deterministic parser is the floor).
#   ollama     — Ollama only, no Anthropic fallback.
#   anthropic  — Anthropic only, no Ollama fallback.
#   (unset)    — 'auto': Ollama first (free, local), Anthropic on Ollama miss.
# Ollama is free — leave this unset/'auto' to get it. Set 'off' if you want
# ANTHROPIC_API_KEY active for narration/NPC voice without ANY intent-
# proposal calls (Ollama included).
INTENT_LLM=

# Optional: default UI selection (client still allows OFF/POLISH/CONDUCT)
AI_MODE=OFF

# Optional: override server-side model (default is a lightweight model)
OPENAI_MODEL=gpt-4.1-mini
